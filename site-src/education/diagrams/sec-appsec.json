[
  {
    "id": "ssrf-path",
    "caption": "Server-side request forgery: the attacker cannot reach the metadata service or the internal admin panel directly, so they make your server fetch it for them. The fix is a fetcher that allow-lists destinations, blocks internal ranges after DNS resolution, and holds no cloud role.",
    "alt": "An attacker outside the network submits a URL to the application's fetch feature. The application, inside the network, makes the request. Without controls, the request reaches the cloud instance metadata service and an internal admin panel, and the response, including credentials, is returned to the attacker. With controls, an allow-list and address checks in a fetcher component without a cloud role only permit requests to approved external hosts.",
    "place": {
      "section": 3,
      "after": 0
    },
    "groups": [
      {
        "label": "Inside the network",
        "col": 1,
        "row": 0,
        "w": 4,
        "h": 2
      }
    ],
    "nodes": [
      {
        "id": "attacker",
        "label": "Attacker",
        "sub": "url=http://169.254...",
        "col": 0,
        "row": 0,
        "kind": "danger"
      },
      {
        "id": "app",
        "label": "App: fetch(url)",
        "sub": "has a cloud role",
        "col": 2,
        "row": 0,
        "kind": "accent"
      },
      {
        "id": "meta",
        "label": "Metadata service",
        "sub": "169.254.169.254",
        "col": 4,
        "row": 0,
        "kind": "store"
      },
      {
        "id": "admin",
        "label": "Internal admin",
        "sub": "no auth, private IP",
        "col": 4,
        "row": 1,
        "kind": "muted"
      },
      {
        "id": "fetcher",
        "label": "Safe fetcher",
        "sub": "allow-list, no role",
        "col": 1,
        "row": 1,
        "kind": "ok"
      },
      {
        "id": "cdn",
        "label": "Approved host",
        "sub": "cdn.example.com",
        "col": 0,
        "row": 1,
        "kind": "actor"
      }
    ],
    "edges": [
      {
        "from": "attacker",
        "to": "app",
        "label": "1. submit URL",
        "color": "danger"
      },
      {
        "from": "app",
        "to": "meta",
        "label": "2. server fetches it",
        "color": "danger"
      },
      {
        "from": "app",
        "to": "admin",
        "label": "or the admin panel",
        "color": "danger",
        "style": "dashed",
        "route": "vh",
        "offset": 16
      },
      {
        "from": "meta",
        "to": "attacker",
        "label": "3. credentials returned",
        "route": "over",
        "color": "danger"
      },
      {
        "from": "app",
        "to": "fetcher",
        "label": "fix: delegate",
        "color": "ok",
        "route": "vh",
        "offset": -16,
        "label_side": "left"
      },
      {
        "from": "fetcher",
        "to": "cdn",
        "label": "only allow-listed hosts",
        "color": "ok"
      }
    ]
  }
]
