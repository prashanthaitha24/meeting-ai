[
  {
    "id": "k8s-defence-layers",
    "caption": "Five independent layers between an attacker who gets code running in a pod and the rest of the cluster: the image limits what tools exist, the pod's security context limits what the process can do, RBAC limits what the API will allow, network policy limits who it can reach, and admission control makes sure every workload has the other four.",
    "alt": "An attacker has execution inside a container in a pod. Concentric layers surround the pod: a minimal image with no shell or package manager, a restricted security context with non-root user and dropped capabilities, a service account with a scoped role that RBAC checks at the API server, and a network policy that allows only the database and DNS. Admission control sits in front of the API server and rejects any workload that lacks these settings. The node, the cluster API and other namespaces are shown as targets the layers protect.",
    "place": {
      "section": 4,
      "after": 1
    },
