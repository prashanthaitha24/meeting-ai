[
  {
    "id": "tls-handshake",
    "caption": "How a TLS 1.3 connection gets its three guarantees: ephemeral key shares give confidentiality with forward secrecy, the certificate chain to a trusted root gives server authentication, and the record MACs give integrity.",
    "alt": "The client sends a key share to the server. The server replies with its own key share, its certificate and a signature made with the certificate's private key. The client checks the certificate against the intermediate and root certificates in its trust store, verifies the signature, and both sides derive the same session keys from the two key shares. Application data then flows encrypted and authenticated in both directions.",
