    "groups": [
      {"id": "procs", "label": "Stateless processes", "col": 1, "row": 0, "w": 1, "h": 3},
      {"label": "Backing services", "col": 3, "row": 0, "w": 1, "h": 3}
    ],
    "nodes": [
      {"id": "env", "label": "Environment", "sub": "DATABASE_URL=...", "col": 0, "row": 0, "kind": "muted"},
      {"id": "lb", "label": "Load balancer", "col": 0, "row": 1, "kind": "accent"},
      {"id": "logs", "label": "Log collector", "sub": "reads stdout", "col": 0, "row": 2, "kind": "muted"},
      {"id": "p1", "label": "App process", "sub": "replica 1", "col": 1, "row": 0},
      {"id": "p2", "label": "App process", "sub": "replica 2", "col": 1, "row": 1},
      {"id": "p3", "label": "App process", "sub": "replica 3", "col": 1, "row": 2},
      {"id": "db", "label": "PostgreSQL", "sub": "records", "col": 3, "row": 0, "kind": "store"},
      {"id": "redis", "label": "Redis", "sub": "sessions, cache", "col": 3, "row": 1, "kind": "store"},
      {"id": "s3", "label": "Object storage", "sub": "uploads", "col": 3, "row": 2, "kind": "store"}
    ],
    "edges": [
      {"from": "env", "to": "p1", "label": "config at start", "color": "muted", "style": "dashed"},
      {"from": "lb", "to": "p2", "label": "any request, any replica"},
      {"from": "p3", "to": "logs", "label": "one JSON line per event", "color": "muted", "style": "dashed"},
      {"from": "procs", "to": "db", "label": "reads and writes", "route": "straight"},
      {"from": "procs", "to": "redis", "label": "sessions, never in memory", "route": "straight"},
