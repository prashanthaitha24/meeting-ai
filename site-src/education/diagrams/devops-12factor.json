[
  {
    "id": "twelve-factor-shape",
    "caption": "The shape of a twelve-factor deployment: identical stateless processes behind a load balancer, configured from the environment, holding all shared state in attached backing services, and writing logs to stdout for the platform to collect.",
    "alt": "A load balancer sends requests to three identical stateless app processes. Each process reads its configuration from environment variables. All three share a database, a Redis cache for sessions and object storage for uploads. Their logs go to stdout, where a log collector gathers them.",
