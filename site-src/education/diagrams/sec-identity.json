[
  {
    "id": "oidc-code-flow",
    "caption": "The authorization code flow with PKCE: the browser only ever carries a short-lived, single-use code; the app exchanges it server-side, with the verifier, for tokens that the browser never sees.",
    "alt": "The user's browser is redirected from the app to the identity provider's authorize endpoint with a code challenge and state. The user authenticates there. The provider redirects the browser back to the app's callback with a code and the same state. The app's server checks state, then posts the code and the code verifier to the provider's token endpoint and receives an ID token, access token and refresh token. The app validates the ID token and creates its own session.",
    "place": {
      "section": 2,
      "after": 2
    },
    "groups": [
      {
        "label": "Your application",
        "col": 1,
        "row": 0,
        "w": 2,
        "h": 3
      },
      {
        "label": "Identity provider",
        "col": 4,
        "row": 0,
        "w": 1,
        "h": 3
      }
    ],
    "nodes": [
      {
