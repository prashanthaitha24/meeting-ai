[
  {
    "id": "signed-build-chain",
    "caption": "From commit to cluster with nothing unverified in between: the hosted builder signs the image and its provenance with the job's own identity, the SBOM travels as an attestation, and admission refuses anything whose signature, identity or source branch does not match policy.",
    "alt": "A developer's commit on the protected main branch triggers the release workflow on the hosted builder. The builder installs hash-pinned dependencies from a private registry, builds the image, generates an SBOM, and signs the image and its provenance keylessly using an OIDC certificate from Sigstore, recording it in the transparency log. The image, SBOM attestation and provenance are pushed to the registry. At deploy time the cluster's admission controller verifies the signature identity, issuer and source before allowing the pod.",
    "place": {
      "section": 3,
      "after": 1
    },
    "groups": [
      {
        "label": "Hosted builder (SLSA 3)",
        "col": 1,
        "row": 0,
        "w": 3,
        "h": 2
      }
    ],
