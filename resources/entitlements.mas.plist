<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required for all Mac App Store apps -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Electron/V8 JIT compilation — explicitly permitted in MAS sandbox -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Outbound network: Groq, Supabase, Stripe, Vercel backend -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Microphone: live audio transcription via Web Speech API and Groq Whisper -->
    <key>com.apple.security.device.microphone</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Global keyboard shortcuts (⌘⇧Space, ⌘↵) require accessibility -->
    <key>com.apple.security.personal-information.accessibility</key>
    <true/>

    <!-- File access: user-chosen locations via Save dialog (export data, save notes) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
  </dict>
</plist>
